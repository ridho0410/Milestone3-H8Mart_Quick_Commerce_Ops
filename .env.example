# H8Mart Quick-Commerce Ops — salin ke .env lalu ganti semua CHANGE_ME sebelum menjalankan Compose.
# .env berisi rahasia, jangan commit atau kirim ke repo publik.

N8N_VERSION=2.44.7
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_generate_random_32_chars_or_more
POSTGRES_VERSION=16.15-alpine
UPTIME_KUMA_VERSION=2.5.8
MOCK_API_IMAGE=node:24-alpine

EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

PG_SUPERUSER_PASSWORD=CHANGE_ME_database_admin_password
PG_READER_PASSWORD=CHANGE_ME_read_only_password
PG_WRITER_PASSWORD=CHANGE_ME_write_service_password
MOCK_API_KEY=CHANGE_ME_mock_api_key
WEBHOOK_TOKEN=CHANGE_ME_webhook_token

# Telegram bot token dan OpenAI API key disimpan sebagai Credentials di n8n, bukan di file ini.
# KUMA_PUSH_TOKEN hanya dimasukkan ke node/credential n8n setelah monitor Push dibuat di Uptime Kuma.

N8N_HOST_PORT=5690
PG_HOST_PORT=5440
MOCK_API_HOST_PORT=8080
KUMA_HOST_PORT=3011

# VPS saja. Isi nilai riil di .env server, jangan di repo.
DOMAIN_NAME=CHANGE_ME.duckdns.org
SSL_EMAIL=CHANGE_ME@example.com
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_random_64_hex_chars
CADDY_VERSION=2.11.7-alpine
