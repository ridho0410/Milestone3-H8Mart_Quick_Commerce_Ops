    "data_day": "SELECT to_jsonb(d) FROM core.data_info d;",
    "stock_counts": "SELECT json_build_object('rows',count(*),'product_id_filled',count(product_id)) FROM core.merchant_stock;",
    "sync_runs": "SELECT json_agg(x) FROM (SELECT * FROM ops.sync_runs ORDER BY run_id DESC LIMIT 4)x;",
    "refund_ledger": "SELECT json_agg(x) FROM (SELECT order_id,idempotency_key,amount,status,approved_by,payment_ref,note FROM ops.refund_actions ORDER BY order_id)x;",
    "voucher_ledger": "SELECT json_agg(x) FROM (SELECT order_id,idempotency_key,amount,status,payment_ref FROM ops.compensations ORDER BY order_id)x;",
    "dead_letter": "SELECT json_agg(x) FROM (SELECT workflow,node,execution_id,business_key,error_message,payload,attempts FROM ops.dead_letter ORDER BY id)x;",
    "tickets": "SELECT json_agg(x) FROM (SELECT ticket_id,merchant_id,reason,status FROM ops.tickets ORDER BY ticket_id)x;"
  },
