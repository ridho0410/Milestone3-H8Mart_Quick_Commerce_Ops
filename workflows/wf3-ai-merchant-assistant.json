    {
      "id": "0bb3e834-011b-59cd-9e29-519f04202af7",
      "name": "Validasi Pertanyaan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json.body||{};const valid=typeof p.merchant_id==='string'&&/^M\\d{3}$/.test(p.merchant_id)&&typeof p.question==='string'&&p.question.trim().length>0&&p.question.length<=2000;return [{json:{valid,merchant_id:p.merchant_id||'',question:p.question||''}}];"
      }
    },
    {
      "id": "86db8e86-364e-5ffe-82af-3ca9cca398a1",
      "name": "Pertanyaan Valid?",
