          "name": "H8Mart PG Reader"
        }
      }
    },
    {
      "id": "01c3f06b-c9d4-5e00-a0fe-4d1051c802c9",
      "name": "Batasi Scope dan Kemampuan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const p=$json;let reason='';const ids=p.question.toUpperCase().match(/\\bM\\d{3}\\b/g)||[];if(!p.merchant_active)reason='Merchant tidak ditemukan atau tidak aktif';else if(ids.some(id=>id!==p.merchant_id))reason='Permintaan data merchant lain ditolak';else if(/kompensasi|refund|pengembalian uang|ganti rugi|turunkan harga|ubah harga|naikkan harga|besok|prediksi|ramal/i.test(p.question))reason='Pertanyaan uang, perubahan data, atau prediksi harus ditangani CS';return [{json:{...p,blocked_reason:reason,allowed:!reason}}];"
      }
    },
    {
      "id": "31f1c5ef-ba95-51b6-b98c-d7e14adb39ea",
      "name": "Boleh Dijawab dari Data?",
