    {
      "id": "1d2e5e6b-90d2-5b10-97df-c26a7286683e",
      "name": "Ambil Hari Data dan Merchant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        750,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text merchant_id,$2::text question,(SELECT hari_data_terakhir::text FROM core.data_info) tanggal,EXISTS(SELECT 1 FROM core.merchants WHERE merchant_id=$1 AND active) merchant_active",
        "options": {
          "queryReplacement": "={{ [$json.merchant_id,$json.question] }}"
        }
      },
      "credentials": {
