    {
      "id": "f5743698-7a25-514a-9c87-e8690f206258",
      "name": "Parser Output Terstruktur",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"jawaban\": {\"type\": \"string\", \"minLength\": 1}, \"data_dipakai\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}, \"perlu_eskalasi\": {\"type\": \"boolean\"}, \"alasan\": {\"type\": \"string\"}}, \"required\": [\"jawaban\", \"data_dipakai\", \"confidence\", \"perlu_eskalasi\", \"alasan\"]}",
        "autoFix": false
      }
    },
    {
      "id": "d096ed3b-72d7-551c-be39-f9bbf423461a",
      "name": "Validasi Output dan Guardrail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "jsCode": "const input=$json;let out=input.output;try{if(typeof out==='string')out=JSON.parse(out);}catch{out=null;}const steps=input.intermediateSteps||[];const used=steps.some(x=>/KPI_Merchant|Alasan_Batal|Status_Stok/.test(x.action?.tool||x.tool||''));const valid=out&&typeof out.jawaban==='string'&&Array.isArray(out.data_dipakai)&&out.data_dipakai.every(x=>typeof x==='string')&&typeof out.confidence==='number'&&out.confidence>=0&&out.confidence<=1&&typeof out.perlu_eskalasi==='boolean';const forbidden=valid&&/akan.{0,25}(membayar|mendapat kompensasi|menerima kompensasi|dibayar)|akan membayar|akan mendapat kompensasi|akan menerima kompensasi/i.test(out.jawaban);const answered=Boolean(valid&&!out.perlu_eskalasi&&out.confidence>=0.7&&out.data_dipakai.length>0&&used&&!forbidden);return [{json:{answered,jawaban:answered?out.jawaban:'',data_dipakai:answered?out.data_dipakai:[],confidence:answered?Math.min(out.confidence,0.99):0,reason:answered?'':(!valid?'Output AI tidak valid':forbidden?'Jawaban melanggar batas kompensasi':!used?'Jawaban tidak didukung pemanggilan tool':out.alasan||'Confidence rendah atau data tidak cukup')}}];"
      }
    },
