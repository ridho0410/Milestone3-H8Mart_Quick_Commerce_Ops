      "parameters": {
        "language": "pythonNative",
        "pythonCode": "data = _items[0][\"json\"]\nevent, order = data[\"payload\"], data.get(\"order_data\")\nif order is None:\n    return [{\"json\": {\"route\": \"invalid\", \"status\": \"order_tidak_ditemukan\"}}]\ntry:\n    amount = float(order[\"total_amount\"])\nexcept (KeyError, TypeError, ValueError, OverflowError):\n    raise ValueError(\"Nominal order tidak valid\")\nif not 0 < amount <= 9007199254740991 or int(amount) != amount:\n    raise ValueError(\"Nominal order tidak valid\")\norder_id = order[\"order_id\"]\nif event[\"event\"] == \"delivery.late\":\n    result = {\"route\": \"voucher\", \"order_id\": order_id,\n              \"amount\": 10000 if event[\"minutes_late\"] <= 15 else 20000,\n              \"idempotency_key\": \"voucher:\" + order_id}\nelif order.get(\"payment_status\") != \"captured\":\n    result = {\"route\": \"skip\", \"order_id\": order_id, \"status\": \"tidak_perlu_refund\",\n              \"reason\": \"pembayaran_belum_tertagih_atau_sudah_refund\"}\nelse:\n    result = {\"route\": \"refund\", \"order_id\": order_id, \"amount\": int(amount),\n              \"idempotency_key\": \"refund:\" + order_id, \"need_approval\": amount > 150000}\nreturn [{\"json\": result}]"
      },
