      "parameters": {
        "language": "pythonNative",
        "pythonCode": "payload = _items[0][\"json\"].get(\"body\")\nif payload in (None, False, 0, \"\"):\n    payload = {}\ndata = payload if isinstance(payload, dict) else {}\nevent = data.get(\"event\")\norder_id = data.get(\"order_id\")\nif isinstance(order_id, bool) and order_id:\n    order_id = \"true\"\nelif isinstance(order_id, (int, float)) and order_id:\n    order_id = str(int(order_id)) if int(order_id) == order_id else str(order_id)\nminutes = data.get(\"minutes_late\")\nallowed = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-\"\nvalid = (event in (\"delivery.late\", \"order.failed\")\n         and isinstance(order_id, str) and 1 <= len(order_id) <= 80\n         and all(char in allowed for char in order_id)\n         and (event != \"delivery.late\" or (isinstance(minutes, (int, float)) and not isinstance(minutes, bool)\n              and 0 < minutes <= 9007199254740991 and int(minutes) == minutes)))\nreturn [{\"json\": {\"valid\": valid, \"payload\": payload}}]"
      },
