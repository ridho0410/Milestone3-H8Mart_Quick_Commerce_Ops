{
  "id": "MSFNbjwIXWmtNiNm",
  "name": "H8Mart WF3b - Telegram Merchant Chat",
  "nodes": [
    {
      "id": "e5bef801-eab5-551b-88c3-ea77343fb19c",
      "name": "Telegram Trigger Merchant",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "GANTI-ID-H8Mart-Telegram",
          "name": "H8Mart Telegram"
        }
      },
      "webhookId": "h8mart-ridho-telegram-merchant"
    },
    {
      "id": "653c6015-9de4-5068-a0f8-963d46df72de",
      "name": "Cek Allowlist Chat",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text chat_id,$2::text question,(SELECT merchant_id FROM ops.telegram_merchants WHERE chat_id=$1::bigint) merchant_id",
        "options": {
          "queryReplacement": "={{ [$json.message.chat.id,$json.message.text||\"\"] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-H8Mart-PG-Reader",
          "name": "H8Mart PG Reader"
        }
      }
    },
    {
      "id": "5da0a377-e772-57e0-8f17-098c004f6f79",
      "name": "Chat Terdaftar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "allowed",
              "leftValue": "={{ Boolean($json.merchant_id) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ca114813-ccd2-5a22-8871-53cc22c9a37d",
      "name": "Tanya WF3 melalui Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/h8mart-assistant",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {merchant_id:$json.merchant_id,question:$json.question} }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GANTI-ID-H8Mart-Webhook",
          "name": "H8Mart Webhook"
        }
      }
    },
    {
      "id": "f01b593a-8ef3-573d-981b-b8671ca3e95d",
      "name": "Balas Chat Merchant",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1000,
        -100
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $(\"Cek Allowlist Chat\").first().json.chat_id }}",
        "text": "={{ $json.jawaban }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "GANTI-ID-H8Mart-Telegram",
          "name": "H8Mart Telegram"
        }
      },
      "webhookId": "8f1dabb4-4e03-4958-b3c7-6754fbf73ce3"
    },
    {
      "id": "74f09e9d-0023-5c8f-b85b-6eb03fd1b334",
      "name": "Tolak Chat Asing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        750,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Akun Telegram ini belum terdaftar sebagai merchant H8Mart. Hubungi CS untuk registrasi.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "GANTI-ID-H8Mart-Telegram",
          "name": "H8Mart Telegram"
        }
      },
      "webhookId": "77e3af12-190b-47a1-85a2-3648a808f170"
    },
    {
      "id": "14dc2e44-b4b8-5566-8cd4-7706225930d5",
      "name": "Catatan Chat",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -350
      ],
      "parameters": {
        "content": "## WF3b — Chat Telegram Merchant\nPublish setelah HTTPS publik. Trigger v1.5 menerima pesan dan meneruskan callback approval native pada bot yang sama. Merchant berasal dari allowlist chat_id, bukan teks pesan. Pertanyaan diproses oleh WF3.",
        "height": 170,
        "width": 1200
      }
    }
  ],
  "connections": {
    "Telegram Trigger Merchant": {
      "main": [
        [
          {
            "node": "Cek Allowlist Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek Allowlist Chat": {
      "main": [
        [
          {
            "node": "Chat Terdaftar?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat Terdaftar?": {
      "main": [
        [
          {
            "node": "Tanya WF3 melalui Webhook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tolak Chat Asing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tanya WF3 melalui Webhook": {
      "main": [
        [
          {
            "node": "Balas Chat Merchant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "errorWorkflow": "hrWBprPIJJb1NBS9"
  },
  "active": true
}