        "query": "WITH p AS (SELECT $1::jsonb j), req AS (SELECT upper(x.sku) sku,sum(x.qty)::int qty FROM p,jsonb_to_recordset(p.j->'items') x(sku text,qty int) GROUP BY upper(x.sku)), s AS (SELECT req.*,pr.product_id,pr.price,ms.qty tersedia FROM req LEFT JOIN core.products pr USING(sku) LEFT JOIN core.merchant_stock ms ON ms.product_id=pr.product_id AND ms.merchant_id=(SELECT j->>'merchant_id' FROM p)), old AS (SELECT o.* FROM core.orders o,p WHERE o.order_id=p.j->>'order_id'), decision AS (SELECT CASE WHEN EXISTS(SELECT 1 FROM old,p WHERE old.merchant_id<>p.j->>'merchant_id' OR old.customer_id<>p.j->>'customer_id' OR old.total_amount<>(p.j->>'total_amount')::numeric) OR (EXISTS(SELECT 1 FROM old) AND EXISTS((SELECT product_id,qty FROM core.order_items WHERE order_id=(SELECT j->>'order_id' FROM p) EXCEPT SELECT product_id,qty FROM s) UNION ALL (SELECT product_id,qty FROM s EXCEPT SELECT product_id,qty FROM core.order_items WHERE order_id=(SELECT j->>'order_id' FROM p)))) THEN 'konflik' WHEN NOT EXISTS(SELECT 1 FROM core.merchants,p WHERE merchant_id=p.j->>'merchant_id' AND active) OR EXISTS(SELECT 1 FROM s WHERE product_id IS NULL) THEN 'invalid' WHEN EXISTS(SELECT 1 FROM s WHERE tersedia IS NULL OR tersedia<qty) THEN 'habis' WHEN (SELECT sum(qty*price)+8000 FROM s)<>(SELECT (j->>'total_amount')::numeric FROM p) THEN 'invalid' WHEN EXISTS(SELECT 1 FROM s WHERE tersedia-qty<=5) THEN 'tipis' ELSE 'cukup' END route) SELECT (SELECT j FROM p) payload,(SELECT route FROM decision) route,EXISTS(SELECT 1 FROM old) duplicate",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.payload)] }}"
        }
      },
