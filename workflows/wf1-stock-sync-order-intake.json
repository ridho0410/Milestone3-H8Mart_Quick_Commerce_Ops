        "jsCode": "const k=$('Hitung KPI Harian').first().json;let r=$input.first().json;let t=r.content?.find(x=>x.type==='text')?.text;if(t){try{r=(Array.isArray(t)?t:JSON.parse(t))[0]}catch{}}const reasons=r.alasan_batal||r.data?.alasan_batal||[];return [{json:{channel:'ops-digest',title:'Digest H8Mart '+k.tanggal,text:`H8Mart — ${k.tanggal}\\nOrder: ${k.jumlah_order}\\nCancel rate: ${k.cancel_rate_persen}%\\nSLA 30 menit: ${k.sla_persen}%\\nAlasan batal: ${JSON.stringify(reasons)}`}}];"
