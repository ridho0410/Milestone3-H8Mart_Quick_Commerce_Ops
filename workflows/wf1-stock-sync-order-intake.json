      "id": "a6006f94-085f-5e3c-a7eb-e20f2304d7ab",
      "name": "Alasan Batal - MCP Client",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        768,
        2160
      ],
      "alwaysOutputData": false,
