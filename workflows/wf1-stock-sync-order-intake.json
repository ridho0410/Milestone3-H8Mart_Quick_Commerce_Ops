        "query": "WITH prev AS MATERIALIZED (SELECT qty FROM core.merchant_stock WHERE merchant_id=$1 AND product_id=$2), u AS (INSERT INTO core.merchant_stock(merchant_id,product_id,qty,synced_at) VALUES($1,$2,$3,now()) ON CONFLICT(merchant_id,product_id) DO UPDATE SET qty=excluded.qty,synced_at=excluded.synced_at RETURNING merchant_id,product_id,qty) SELECT u.*,COALESCE((SELECT qty>0 FROM prev),false) AND u.qty=0 became_zero,$4::bigint started_at,$5::int merchants_ok,$6::int merchants_total FROM u",
