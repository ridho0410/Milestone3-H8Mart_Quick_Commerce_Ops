    {
      "id": "82869863-1ac1-52d9-a3d0-31bdee3e96b3",
      "name": "Catat Order dan Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1250,
        720
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT $1::jsonb j), req AS (SELECT upper(x.sku) sku,sum(x.qty)::int qty FROM p,jsonb_to_recordset(p.j->'items') x(sku text,qty int) GROUP BY upper(x.sku)), ins AS (INSERT INTO core.orders(order_id,customer_id,merchant_id,zone,order_date,created_at,status,total_amount,payment_status,customer_note) SELECT j->>'order_id',j->>'customer_id',j->>'merchant_id',m.zone,(now() AT TIME ZONE 'Asia/Jakarta')::date,now(),'active',(j->>'total_amount')::numeric,'captured',j->>'customer_note' FROM p JOIN core.merchants m ON m.merchant_id=p.j->>'merchant_id' ON CONFLICT(order_id) DO NOTHING RETURNING order_id), ii AS (INSERT INTO core.order_items(order_id,product_id,qty,unit_price) SELECT ins.order_id,pr.product_id,req.qty,pr.price FROM ins,req JOIN core.products pr USING(sku) RETURNING order_id) SELECT (SELECT j->>'order_id' FROM p) order_id,NOT EXISTS(SELECT 1 FROM ins) duplicate,$2::text stock_status,(SELECT count(*) FROM ii)::int items_written",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.payload),$json.route] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-H8Mart-PG-Writer",
          "name": "H8Mart PG Writer"
        }
