    {
      "id": "4c124fa0-2e2d-531b-9cf6-de6fdcf21623",
      "name": "Validasi Event Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        900
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json.body || {};const valid=p.event==='order.created'&&/^[A-Za-z0-9_-]{1,80}$/.test(p.order_id||'')&&/^M\\d{3}$/.test(p.merchant_id||'')&&typeof p.customer_id==='string'&&p.customer_id.length>0&&p.customer_id.length<=80&&typeof p.total_amount==='number'&&Number.isSafeInteger(p.total_amount)&&p.total_amount>0&&Array.isArray(p.items)&&p.items.length>0&&p.items.length<=50&&p.items.every(x=>typeof x.sku==='string'&&/^SKU-\\d{3}$/.test(x.sku.toUpperCase())&&typeof x.qty==='number'&&Number.isSafeInteger(x.qty)&&x.qty>0&&x.qty<=100000)&&(!p.customer_note||(typeof p.customer_note==='string'&&p.customer_note.length<=2000));return [{json:{valid,payload:p}}];"
      }
    },
    {
      "id": "8f1e0d2e-abe9-53ce-9429-7a8a95f96415",
      "name": "Event Order Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        900
      ],
      "parameters": {
        "conditions": {
          "options": {
