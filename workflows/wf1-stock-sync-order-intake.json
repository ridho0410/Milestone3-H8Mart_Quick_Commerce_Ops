    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json\nentry = _items[0][\"json\"]\nkpi, result = entry[\"kpi\"], entry[\"result\"]\nfor part in result.get(\"content\") or []:\n    if part.get(\"type\") == \"text\":\n        text = part.get(\"text\")\n        if text:\n            try:\n                parsed = text if isinstance(text, list) else json.loads(text)\n                if isinstance(parsed, list) and parsed and isinstance(parsed[0], dict):\n                    result = parsed[0]\n                elif isinstance(parsed, dict) and isinstance(parsed.get(\"0\"), dict):\n                    result = parsed[\"0\"]\n            except (ValueError, TypeError):\n                pass\n        break\nreasons = result.get(\"alasan_batal\")\nif reasons in (None, False, 0, \"\"):\n    reasons = (result.get(\"data\") or {}).get(\"alasan_batal\")\nif reasons in (None, False, 0, \"\"):\n    reasons = []\ndate = kpi[\"tanggal\"]\norders, cancel, sla = (\"null\" if kpi.get(key) is None else kpi[key]\n                       for key in (\"jumlah_order\", \"cancel_rate_persen\", \"sla_persen\"))\nreasons_json = json.dumps(reasons, ensure_ascii=False, separators=(\",\", \":\"))\nreturn [{\"json\": {\"channel\": \"ops-digest\", \"title\": \"Digest H8Mart \" + date,\n                  \"text\": f\"H8Mart — {date}\\nOrder: {orders}\\nCancel rate: {cancel}%\\nSLA 30 menit: {sla}%\\nAlasan batal: {reasons_json}\"}}]"
      },
