    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "def json_string(value):\n    escaped = []\n    for char in value:\n        if char in ('\"', '\\\\'):\n            escaped.append('\\\\' + char)\n        elif ord(char) < 32:\n            escaped.append('\\\\u%04x' % ord(char))\n        else:\n            escaped.append(char)\n    return '\"' + ''.join(escaped) + '\"'\n\n\nfor item in _items:\n    data = item[\"json\"]\n    product = data.get(\"product_id\")\n    if product in (None, False, 0, \"\"):\n        parts = []\n        if \"merchant_id\" in data:\n            merchant = data[\"merchant_id\"]\n            parts.append('\"business_key\":' + (json_string(merchant) if merchant is not None else \"null\"))\n        sku = data.get(\"sku\", \"undefined\")\n        parts.append('\"message\":' + json_string(\"SKU tidak ada di katalog: \" + str(sku)))\n        raise ValueError(\"{\" + \",\".join(parts) + \"}\")\nreturn _items"
      },
