    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "def matches_id(value, allowed, minimum, maximum):\n    return isinstance(value, str) and minimum <= len(value) <= maximum and all(\n        char in allowed for char in value\n    )\n\n\ndef sku_valid(value):\n    if not isinstance(value, str):\n        return False\n    value = value.upper()\n    return value.startswith(\"SKU-\") and matches_id(value[4:], \"0123456789\", 3, 3)\n\n\ndef positive_integer(value, maximum):\n    return (isinstance(value, (int, float)) and not isinstance(value, bool)\n            and 0 < value <= maximum and int(value) == value)\n\n\ndef within_limit(value, limit):\n    # JavaScript counts UTF-16 code units, including surrogate pairs.\n    return isinstance(value, str) and sum(2 if ord(char) > 65535 else 1 for char in value) <= limit\n\n\npayload = _items[0][\"json\"].get(\"body\")\nif payload in (None, False, 0, \"\"):\n    payload = {}\norder = payload if isinstance(payload, dict) else {}\nmerchant_id = order.get(\"merchant_id\")\ncustomer_id = order.get(\"customer_id\")\nitems = order.get(\"items\")\nnote = order.get(\"customer_note\")\nvalid = (\n    order.get(\"event\") == \"order.created\"\n    and matches_id(order.get(\"order_id\"), \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-\", 1, 80)\n    and isinstance(merchant_id, str)\n    and merchant_id.startswith(\"M\")\n    and matches_id(merchant_id[1:], \"0123456789\", 3, 3)\n    and bool(customer_id)\n    and within_limit(customer_id, 80)\n    and positive_integer(order.get(\"total_amount\"), 9007199254740991)\n    and isinstance(items, list)\n    and 0 < len(items) <= 50\n    and all(isinstance(item, dict) and sku_valid(item.get(\"sku\"))\n            and positive_integer(item.get(\"qty\"), 100000) for item in items)\n    and (note in (None, False, 0, \"\") or within_limit(note, 2000))\n)\nreturn [{\"json\": {\"valid\": valid, \"payload\": payload}}]"
      },
