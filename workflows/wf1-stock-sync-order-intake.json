    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json\nimport re\n\nresults = [item[\"json\"] for item in _items]\nmerchants_ok = sum(isinstance(row[\"record\"].get(\"items\"), list) and bool(row[\"record\"][\"items\"]) for row in results)\nrows = []\nfor entry in results:\n    record = entry[\"record\"]\n    items = record.get(\"items\")\n    if not isinstance(items, list):\n        continue\n    seen = set()\n    for item in items:\n        sku = str(item.get(\"sku\") or \"\").strip().upper()\n        value = item.get(\"qty\")\n        try:\n            if \"qty\" not in item:\n                qty = -1\n            elif value is None or (isinstance(value, str) and not value.strip()) or value == []:\n                qty = 0\n            elif isinstance(value, str) and value.strip().lower().startswith((\"0x\", \"0b\", \"0o\")):\n                qty = int(value.strip(), 0)\n            else:\n                qty = float(value)\n        except (TypeError, ValueError, OverflowError):\n            qty = -1\n        if not re.fullmatch(r\"SKU-[0-9]{3}\", sku) or not 0 <= qty <= 9007199254740991 or int(qty) != qty or sku in seen:\n            error = {key: record[key] for key in (\"merchant_id\",) if key in record}\n            if \"merchant_id\" in error:\n                error[\"business_key\"] = error.pop(\"merchant_id\")\n            error[\"message\"] = \"Format stok API tidak valid\"\n            raise ValueError(json.dumps(error, ensure_ascii=False, separators=(\",\", \":\")))\n        seen.add(sku)\n        data = {key: record[key] for key in (\"merchant_id\", \"as_of\") if key in record}\n        data.update(sku=sku, qty=int(qty), startedAt=entry[\"startedAt\"],\n                    merchants_total=len(results), merchants_ok=merchants_ok, has_rows=True)\n        rows.append({\"json\": data})\nreturn rows or [{\"json\": {\"has_rows\": False}}]"
      },
