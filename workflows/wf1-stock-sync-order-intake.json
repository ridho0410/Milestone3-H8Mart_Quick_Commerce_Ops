    {
      "id": "b5cbac94-ece8-52f4-abe9-496ecc428c84",
      "name": "Normalisasi Stok",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -180
      ],
      "parameters": {
        "jsCode": "const results=$input.all().map(i=>i.json); const rows=[]; for(const r of results){if(!Array.isArray(r.items))continue; const seen=new Set(); for(const i of r.items){const sku=String(i.sku||'').trim().toUpperCase();const qty=Number(i.qty);if(!/^SKU-\\d{3}$/.test(sku)||!Number.isSafeInteger(qty)||qty<0||seen.has(sku))throw new Error(JSON.stringify({business_key:r.merchant_id,message:'Format stok API tidak valid'}));seen.add(sku);rows.push({json:{merchant_id:r.merchant_id,sku,qty,as_of:r.as_of,startedAt:$('Mulai Sinkron').first().json.startedAt,merchants_total:results.length,merchants_ok:results.filter(x=>Array.isArray(x.items)&&x.items.length>0).length,has_rows:true}})}} return rows.length?rows:[{json:{has_rows:false}}];"
      }
