        "language": "pythonNative",
        "pythonCode": "import datetime\nimport json\nevent = _items[0][\"json\"]\nexecution = event.get(\"execution\") or {}\nerror = execution.get(\"error\")\nif error in (None, False, 0, \"\"):\n    error = event.get(\"error\") or {}\nmessage = error.get(\"message\")\ntry:\n    context = json.loads(message or \"{}\")\nexcept (ValueError, TypeError):\n    context = {}\nif not isinstance(context, dict):\n    context = {}\nkey = context.get(\"business_key\") or event.get(\"business_key\") or \"tidak-tersedia\"\nworkflow = (event.get(\"workflow\") or {}).get(\"name\") or context.get(\"workflow\") or \"H8Mart\"\nnode = (error.get(\"node\") or {}).get(\"name\") or execution.get(\"lastNodeExecuted\") or context.get(\"node\") or \"tidak-tersedia\"\nnow = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\nmessage = context.get(\"message\") or message or \"Kegagalan tidak dikenal\"\nreturn [{\"json\": {\"channel\": \"ops-alerts\", \"title\": \"H8Mart - Kegagalan workflow\",\n                  \"text\": f\"Workflow: {workflow}\\nNode: {node}\\nWaktu: {now}\\nBusiness key: {key}\\nError: {message}\"}}]"
