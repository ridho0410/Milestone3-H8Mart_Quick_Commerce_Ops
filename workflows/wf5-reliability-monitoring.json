      "parameters": {
        "jsCode": "const e=$input.first().json; const err=e.execution?.error || e.error || {}; let ctx={}; try {ctx=JSON.parse(err.message||'{}')}catch{}; const key=ctx.business_key || e.business_key || 'tidak-tersedia'; return [{json:{channel:'ops-alerts',title:'H8Mart - Kegagalan workflow',text:`Workflow: ${e.workflow?.name || ctx.workflow || 'H8Mart'}\\nNode: ${err.node?.name || e.execution?.lastNodeExecuted || ctx.node || 'tidak-tersedia'}\\nWaktu: ${new Date().toISOString()}\\nBusiness key: ${key}\\nError: ${ctx.message || err.message || 'Kegagalan tidak dikenal'}`}}];"
      }
    },
    {
      "id": "3cb166f2-9783-59da-9f22-abcab9fed3c4",
      "name": "Jejak Alert Notification",
